# Copy to .env — every value has a working local default except REDIS_URL.

# Client the browser tests open. Unset → nearest .worktree-state.json → http://localhost:3000.
# Use a stack on a DEDICATED seeded database (docs/test-plan.md §1), not your dev data.
E2E_BASE_URL=http://localhost:3600

# The API origin, for operator endpoints the client does not proxy
# (/health/*, /api-docs*, /admin/queues)
E2E_API_URL=http://localhost:5600

# Seeded accounts (server: pnpm seed)
E2E_USER_EMAIL=user@test.com
E2E_USER_PASSWORD=User@123
E2E_ADMIN_EMAIL=admin@test.com
E2E_ADMIN_PASSWORD=Admin@123

# The SAME Redis the API server uses (server/.env REDIS_URL). The suite writes
# known OTP / magic-link hashes into it and clears rate-limit counters between
# tests — it never reads codes out of an inbox.
REDIS_URL=redis://localhost:6379

# The SAME MongoDB the API server uses (server/.env DB_URL + DB_NAME). Used only
# to delete throwaway accounts (…@e2e.example.com) after a run.
MONGO_URL=mongodb://localhost:27017/?replicaSet=rs0
MONGO_DB_NAME=ducker-id-e2e
