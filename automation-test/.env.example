# Overrides only. Everything else is read from the app itself (src/config/env.ts):
#   web URL     client NEXT_PUBLIC_SITE_URL      API prefix  client NEXT_PUBLIC_API_PREFIX
#   API origin  client API_SERVER_URL            Redis/Mongo server REDIS_URL / DB_URL / DB_NAME
#   accounts    server/src/database/seeders/data/users.ts
# from client/.env(.local) and server/.env, or their .env.example in a fresh worktree.
# Order: shell > this file > client/server .env > client/server .env.example.

# The e2e stack (src/docs/test-plan.md §1) — a DEDICATED seeded database, never your dev data.
E2E_BASE_URL=http://localhost:3600
E2E_API_URL=http://localhost:5600
DB_NAME=ducker-id-e2e

# Optional — only when the seeded accounts differ from the seeder:
# E2E_USER_EMAIL=user@test.com
# E2E_USER_PASSWORD=
# E2E_ADMIN_EMAIL=admin@test.com
# E2E_ADMIN_PASSWORD=
