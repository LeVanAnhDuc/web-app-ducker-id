{
  "name": "web-app-ducker-id-automation-test",
  "private": true,
  "version": "2.0.0",
  "description": "Ducker ID regression suite — UI E2E and API tests (Playwright)",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "test": "playwright test --project=app*",
    "test:smoke": "playwright test --project=app* --grep @smoke",
    "test:full": "cross-env FULL=1 playwright test --project=app*",
    "test:e2e": "playwright test --project=app* src/tests/e2e",
    "test:api": "playwright test --project=app* src/tests/api",
    "test:unit": "playwright test --project=unit",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --project=app* src/tests/e2e --headed",
    "coverage:check": "tsx scripts/coverage-check.ts",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "lint-staged": {
    "**/*.{ts,json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "24.6.0",
    "bcryptjs": "2.4.3",
    "dotenv": "16.6.1",
    "lint-staged": "15.5.2",
    "mongodb": "6.20.0",
    "prettier": "3.5.3",
    "redis": "4.7.1",
    "tsx": "4.20.6",
    "typescript": "5.8.3",
    "cross-env": "7.0.3"
  }
}
