                      },
                      "data": {
                        "type": "object"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "data": {
                        "type": "object",
                        "properties": {
                          "updated": {
                            "type": "integer",
                            "example": 4
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "401": {
