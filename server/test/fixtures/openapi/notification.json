  "/notifications/read-all": {
    "patch": {
      "summary": "Mark all my notifications as read",
      "tags": [
        "Notifications"
      ],
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "responses": {
        "200": {
          "description": "All notifications marked as read",
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "type": "object",
                    "properties": {
                      "timestamp": {
                        "type": "string",
