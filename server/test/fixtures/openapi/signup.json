                      },
                      "path": {
                        "type": "string",
                        "example": "/api/v1/auth/login"
                      },
                      "message": {
                        "type": "string",
                        "example": "Operation successful"
                      },
                      "data": {
                        "type": "object"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "data": {
                        "type": "object",
                        "properties": {
                          "available": {
