  "/auth/login/otp/verify": {
    "post": {
      "summary": "Verify OTP and login",
      "description": "Verify the OTP code and authenticate the user.\n\n**Security:**\n- `5` failed attempts before lockout (`15 minutes`)\n\n**Returns:**\n- Access token (`15 min` expiry)\n- Refresh token in HTTP-only cookie (`7 days` expiry)\n- ID token",
      "tags": ["Auth - Login"],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["email", "otp"],
              "properties": {
                "email": {
                  "type": "string",
                  "format": "email",
                  "minLength": 3,
                  "maxLength": 254,
                  "example": "user@example.com"
                },
                "otp": {
                  "type": "string",
                  "minLength": 6,
                  "maxLength": 6,
                  "pattern": "^\\d+$",
                  "example": "123456"
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Login successful",
