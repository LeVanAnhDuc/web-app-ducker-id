                    "type": "string"
                  },
                  "errors": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "field": {
                          "type": "string",
                          "example": "email"
                        },
                        "reason": {
                          "type": "string",
                          "example": "any.required"
                        },
                        "message": {
                          "type": "string",
                          "example": "Email is required"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "429": {
          "description": "Too many requests - Rate limit exceeded",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
