{
  "/auth/logout": {
    "post": {
      "summary": "Logout user",
      "description": "Clear refresh token cookie and logout.\nClient should also delete access token from memory.\n\n**Authentication:**\n- Requires valid access token (Bearer)\n\n**Actions:**\n- Clears refresh token HTTP-only cookie",
      "tags": ["Auth - Session"],
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "responses": {
        "200": {
          "description": "Logged out successfully",
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "type": "object",
                    "properties": {
                      "timestamp": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-01-15T10:30:00.000Z"
                      },
                      "path": {
                        "type": "string",
                        "example": "/api/v1/auth/login"
                      },
                      "message": {
                        "type": "string",
                        "example": "Operation successful"
                      },
                      "data": {
                        "type": "object"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "data": {
                        "type": "object",
                        "properties": {
                          "success": {
                            "type": "boolean",
                            "example": true,
                            "description": "Logout success status"
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "401": {
          "description": "Unauthorized - Invalid credentials",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "example": "BAD_REQUEST"
                  },
                  "message": {
                    "type": "string",
                    "example": "Error message"
                  },
                  "timestamp": {
                    "type": "string",
                    "format": "date-time",
                    "example": "2025-01-15T10:30:00.000Z"
                  },
                  "path": {
                    "type": "string",
                    "example": "/api/v1/auth/login"
                  },
                  "errors": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "field": {
                          "type": "string",
                          "example": "email"
                        },
                        "reason": {
                          "type": "string",
                          "example": "any.required"
                        },
                        "message": {
                          "type": "string",
                          "example": "Email is required"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
