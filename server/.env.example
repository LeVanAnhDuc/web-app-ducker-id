NODE_ENV=development
APP_PORT=5000
CLIENT_URL=http://localhost:3000
# Thêm origin của từng app vệ tinh — /oauth/token được gọi TỪ TRÌNH DUYỆT của
# app đó nên đây là một CORS request thật. Thiếu origin ở đây là thứ hỏng đầu tiên.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://levananhduc.github.io
LOG_LEVEL=info
ALLOW_CROSS_ORIGIN_COOKIES=false
# Express "trust proxy" setting. Controls how req.ip resolves x-forwarded-for.
# Set to the exact number of trusted proxy hops (e.g. 1) or a proxy subnet.
# Do NOT use "true" in production — it lets any client spoof the logged IP.
TRUST_PROXY=loopback

# Transactions need a replica set: start mongod with --replSet rs0 and run rs.initiate() once.
DB_URL=mongodb://localhost:27017/?replicaSet=rs0
DB_NAME=ducker-id
# Optional — the values below are the defaults used when unset.
DB_MAX_POOL_SIZE=10
DB_MIN_POOL_SIZE=2
DB_SERVER_SELECTION_TIMEOUT_MS=5000
DB_SOCKET_TIMEOUT_MS=45000

REDIS_URL=redis://localhost:6379
# Optional — the values below are the defaults used when unset.
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_MAX_RECONNECT_ATTEMPTS=10
REDIS_RECONNECT_BASE_DELAY_MS=100
REDIS_RECONNECT_MAX_DELAY_MS=2000

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ID_SECRET=change-me

# ── OIDC provider ──
# OIDC_ISSUER phải là origin mà TRÌNH DUYỆT thấy (client Next.js rewrite
# /oauth/* và /.well-known/* về Express), không phải origin nội bộ của Express.
OIDC_ISSUER=http://localhost:3000
# Khoá ký RS256. Bỏ trống ở dev → server tự sinh keypair tạm mỗi lần khởi động
# (token cũ mất hiệu lực sau restart). BẮT BUỘC cấp ở production.
# Sinh khoá: openssl genrsa -out private.pem 2048
#            openssl rsa -in private.pem -pubout -out public.pem
OAUTH_PRIVATE_KEY=
OAUTH_PUBLIC_KEY=
OAUTH_KEY_ID=

USERNAME_EMAIL=
PASSWORD_EMAIL=
